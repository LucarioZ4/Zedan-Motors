# ========================================================
# Zedan Motors - Variables de Entorno (Docker / Local)
# ========================================================

# Base de Datos (PostgreSQL)
# NOTA: Si ya tienes PostgreSQL instalado en Windows en el puerto 5432,
# puedes cambiar DB_PORT a 5433 para evitar colisiones al levantar el contenedor.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zedan_motors
DB_USER=postgres
DB_PASSWORD=postgres_secure_pass

# Backend API
PORT=3000
JWT_SECRET=super_secret_jwt_key_zedan_2026_change_me
JWT_EXPIRES_IN=8h
FACTUS_API_URL=
FACTUS_API_TOKEN=

# n8n (Motor de Automatización)
# NOTA: Si ya tienes otro contenedor de n8n activo en el puerto 5678,
# puedes cambiar N8N_PORT a 5679 para evitar conflicto de puertos.
N8N_PORT=5678
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_COMMUNITY_PACKAGES_ENABLED=true
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
WEBHOOK_URL=http://localhost:5678/

# OpenWA (WhatsApp API & Dashboard)
# Acceso web al dashboard: http://localhost:2785
OPENWA_PORT=2785

# Credenciales de IA para n8n
DEEPSEEK_API_KEY=
