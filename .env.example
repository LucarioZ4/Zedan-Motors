# ========================================================
# Zedan Motors - Variables de Entorno (Docker / Local)
# ========================================================

# Backend y Supabase
# El servicio backend carga DATABASE_URL y los secretos desde backend/.env.
# Copia backend/.env.example a backend/.env y configura tu conexión Supabase.
# Este archivo controla los puertos y las opciones de Docker Compose.
PORT=3000

# n8n (Motor de Automatización)
# NOTA: Si ya tienes otro contenedor de n8n activo en el puerto 5678,
# puedes cambiar N8N_PORT a 5679 para evitar conflicto de puertos.
N8N_PORT=5678
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_COMMUNITY_PACKAGES_ENABLED=true
GENERIC_TIMEZONE=America/Bogota
TZ=America/Bogota
WEBHOOK_URL=http://n8n:5678/

# Recuperación de contraseña de n8n por correo (ejemplo con Gmail)
# URL que abre el usuario desde el correo; ajusta el puerto si cambia N8N_PORT.
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=
# Gmail requiere una contraseña de aplicación.
N8N_SMTP_PASS=
N8N_SMTP_SENDER=
N8N_SMTP_SSL=true
N8N_SMTP_STARTTLS=false

# OpenWA (WhatsApp API & Dashboard)
# Acceso web al dashboard: http://localhost:2785
OPENWA_PORT=2785

# Credenciales de IA para n8n
DEEPSEEK_API_KEY=
