PORT=3000
DATABASE_URL=postgresql://usuario:password@host:port/database
JWT_SECRET=tu_jwt_secret_minimo_32_caracteres_aqui
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Factus (Facturación electrónica)
FACTUS_API_URL=https://api-sandbox.factus.com.co/v1
FACTUS_API_TOKEN=tu_token_factus

# ── Inventario con IA (Google Gemini - Gratis) ──
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash

# ── Inventario con IA (Anthropic Claude - Opcional) ──
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Videos de recepción y entrega (Supabase Storage) ──
# Supabase -> Project Settings -> API. La service_role es SECRETA: solo en el servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key
VIDEOS_BUCKET=videos-ordenes
VIDEO_MAX_MB=50

# ── Envío de correos y facturas en PDF (Nodemailer + Gmail) ──
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_clave_de_aplicacion_gmail
