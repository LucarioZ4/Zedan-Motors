<Page x:Class="GUI.PageMensajes"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1400"
      Background="#FFFFFF"
      FontFamily="Segoe UI">

    <Page.Resources>

        <!-- Brushes globales -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DBEAFE"/>

        <!-- Tarjeta base -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#DBE4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#1E3A8A"
                                      BlurRadius="20"
                                      ShadowDepth="0"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Labels -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- TextBox moderno -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <Setter Property="SelectionBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#DBE4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                x:Name="border">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#93C5FD"/>
                                <Setter Property="Background" TargetName="border" Value="#E0F2FE"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#3B82F6"/>
                                <Setter Property="Background" TargetName="border" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#EFF6FF"/>
            <Setter Property="Foreground" Value="#1E3A8A"/>
            <Setter Property="BorderBrush" Value="#DBE4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#1E3A8A"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E3A8A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de Acción Moderno -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ◄ LISTA IZQUIERDA ◄ -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Mensajes registrados"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E3A8A" Margin="0,0,0,4"/>
                    <TextBlock Text="Historial de comunicaciones con clientes"
                               FontSize="13" Foreground="#64748B"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="DgMensajes"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="45"
                          SelectionChanged="DgMensajes_SelectionChanged">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,0,0,12"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#1E3A8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="60"
                                            Binding="{Binding IdMensaje}"/>
                        <DataGridTextColumn Header="Fecha" Width="130"
                                            Binding="{Binding Fecha, StringFormat='dd/MM/yyyy HH:mm'}"/>
                        <DataGridTextColumn Header="Orden" Width="80"
                                            Binding="{Binding IdOrden}"/>
                        <DataGridTextColumn Header="Número" Width="130"
                                            Binding="{Binding NumeroCliente}"/>
                        <DataGridTemplateColumn Header="Plataforma" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Plataforma}"
                                                                 Value="Telegram">
                                                        <Setter Property="Background" Value="#E0F2FE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="WhatsApp"/>
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Plataforma}"
                                                                     Value="Telegram">
                                                            <Setter Property="Text" Value="Telegram"/>
                                                            <Setter Property="Foreground" Value="#0369A1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tipo" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,4"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TipoMensaje}"
                                                                 Value="Enviado">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TipoMensaje}"
                                                                 Value="Recibido">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TipoMensaje}"
                                                                 Value="Autorizacion">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TipoMensaje}"
                                                                 Value="Notificacion">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Text="{Binding TipoMensaje}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TipoMensaje}"
                                                                     Value="Enviado">
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TipoMensaje}"
                                                                     Value="Recibido">
                                                            <Setter Property="Foreground" Value="#92400E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TipoMensaje}"
                                                                     Value="Autorizacion">
                                                            <Setter Property="Foreground" Value="#6B21A8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TipoMensaje}"
                                                                     Value="Notificacion">
                                                            <Setter Property="Foreground" Value="#1E40AF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mensaje" Width="*"
                                            Binding="{Binding Mensaje}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ◄ PANEL DERECHO - Formulario ◄ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="Registrar mensaje"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="#1E3A8A" Margin="0,0,0,4"/>
                    <TextBlock Text="Copia el mensaje desde WhatsApp o Telegram y pégalo aquí"
                               FontSize="13" Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="0,0,0,28"/>

                    <!-- Orden -->
                    <TextBlock Text="ORDEN ASOCIADA" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CboOrden"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="ResumenOrden"
                              SelectedValuePath="IdOrden"/>

                    <!-- Número cliente -->
                    <TextBlock Text="NÚMERO DEL CLIENTE" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtNumero"
                             Style="{StaticResource ModernTextBox}"/>

                    <!-- Plataforma -->
                    <TextBlock Text="PLATAFORMA" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CboPlataforma"
                              Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="WhatsApp"/>
                        <ComboBoxItem Content="Telegram"/>
                    </ComboBox>

                    <!-- Tipo -->
                    <TextBlock Text="TIPO DE MENSAJE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CboTipo"
                              Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Enviado"/>
                        <ComboBoxItem Content="Recibido"/>
                        <ComboBoxItem Content="Autorizacion"/>
                        <ComboBoxItem Content="Notificacion"/>
                    </ComboBox>

                    <!-- Mensaje -->
                    <TextBlock Text="MENSAJE" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtMensaje"
                             Style="{StaticResource ModernTextBox}"
                             Height="100"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <!-- Error -->
                    <TextBlock x:Name="TxtError"
                               FontSize="12" FontWeight="Medium" Foreground="#EF4444"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <!-- Botones -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource ActionBtn}"
                                Content="Guardar"
                                Click="BtnGuardar_Click">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#1E3A8A" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource ActionBtn}"
                                Background="#F1F5F9"
                                Foreground="#475569"
                                Content="Eliminar"
                                Click="BtnEliminar_Click"/>
                    </Grid>

                    <Button Style="{StaticResource ActionBtn}"
                            Background="Transparent"
                            Foreground="#64748B"
                            Content="Limpiar"
                            Margin="0,12,0,0"
                            Click="BtnLimpiar_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
